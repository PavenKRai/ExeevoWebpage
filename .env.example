# Endpoint that receives validated demo requests (e.g. a Dynamics 365 Customer Insights - Journeys form)
CRM_FORM_ENDPOINT=
# Canonical site URL, used for canonicals, sitemap, robots and Open Graph. Production is https://exeevo.com (also the default
# for production builds when unset); set it to the staging host on staging, and to http://localhost:3000 in local .env.local
NEXT_PUBLIC_SITE_URL=https://exeevo.com
