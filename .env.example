# Endpoint that receives validated demo requests (e.g. a Dynamics 365 Customer Insights - Journeys form)
CRM_FORM_ENDPOINT=
# Canonical site URL, used for canonicals, sitemap, robots and Open Graph. Production is https://exeevo.com (also the default
# for production builds when unset); set it to the staging host on staging, and to http://localhost:3000 in local .env.local
# On the temporary Vercel test link set this to that exact URL (e.g. https://exeevo-test.vercel.app): the site then tells
# search engines not to index it. Switch it to https://exeevo.com at launch.
NEXT_PUBLIC_SITE_URL=https://exeevo.com

# Sanity CMS (https://exeevo.sanity.studio). Leave the project ID empty to use the bundled content (local dev and tests).
NEXT_PUBLIC_SANITY_PROJECT_ID=5852jf8n
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the Sanity publish webhook (https://<site>/api/revalidate). Generate a long random string.
SANITY_REVALIDATE_SECRET=
